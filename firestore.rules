rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'displayName', 'minAttendance'])
        && data.userId is string && data.userId.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.minAttendance is number && data.minAttendance >= 0 && data.minAttendance <= 100
        && (!('college' in data) || (data.college is string && data.college.size() <= 150))
        && (!('semester' in data) || (data.semester is string && data.semester.size() <= 50))
        && (!('rollNumber' in data) || (data.rollNumber is string && data.rollNumber.size() <= 50))
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('theme' in data) || (data.theme is string && data.theme.size() <= 10))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'attended', 'total'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.attended is number && data.attended >= 0
        && data.total is number && data.total >= data.attended
        && (!('code' in data) || (data.code is string && data.code.size() <= 30))
        && (!('cancelled' in data) || (data.cancelled is number && data.cancelled >= 0))
        && (!('minAttendance' in data) || (data.minAttendance is number && data.minAttendance >= 0 && data.minAttendance <= 100))
        && (!('room' in data) || (data.room is string && data.room.size() <= 60))
        && (!('faculty' in data) || (data.faculty is string && data.faculty.size() <= 100))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'subjectId', 'date', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.subjectId is string && data.subjectId.size() <= 128
        && data.date is string && data.date.size() <= 20
        && data.status is string && (data.status == 'present' || data.status == 'absent' || data.status == 'cancelled')
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 100))
        && (!('time' in data) || (data.time is string && data.time.size() <= 30))
        && (!('note' in data) || (data.note is string && data.note.size() <= 200))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidTimetableSlot(data) {
      return data.keys().hasAll(['id', 'userId', 'day', 'subjectId', 'startTime'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.day is string && (data.day == 'Monday' || data.day == 'Tuesday' || data.day == 'Wednesday' || data.day == 'Thursday' || data.day == 'Friday' || data.day == 'Saturday')
        && data.subjectId is string && data.subjectId.size() <= 128
        && data.startTime is string && data.startTime.size() <= 20
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 100))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 20))
        && (!('room' in data) || (data.room is string && data.room.size() <= 60))
        && (!('faculty' in data) || (data.faculty is string && data.faculty.size() <= 100))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) && request.resource.data.userId == userId && resource.data.userId == userId;
      allow delete: if false;

      match /subjects/{subjectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subjectId) && isValidSubject(request.resource.data) && request.resource.data.userId == userId && request.resource.data.id == subjectId;
        allow update: if isOwner(userId) && isValidId(subjectId) && isValidSubject(request.resource.data) && request.resource.data.userId == userId && resource.data.userId == userId && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      match /attendanceRecords/{recordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) && isValidAttendanceRecord(request.resource.data) && request.resource.data.userId == userId && request.resource.data.id == recordId;
        allow update: if isOwner(userId) && isValidId(recordId) && isValidAttendanceRecord(request.resource.data) && request.resource.data.userId == userId && resource.data.userId == userId && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      match /timetable/{slotId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(slotId) && isValidTimetableSlot(request.resource.data) && request.resource.data.userId == userId && request.resource.data.id == slotId;
        allow update: if isOwner(userId) && isValidId(slotId) && isValidTimetableSlot(request.resource.data) && request.resource.data.userId == userId && resource.data.userId == userId && request.resource.data.id == resource.data.id;
        allow delete: if isOwner(userId) && isValidId(slotId);
      }
    }
  }
}
